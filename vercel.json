{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/check-homework", "schedule": "0 15 * * *" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  }
}
